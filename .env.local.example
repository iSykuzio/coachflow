# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site origin used in invitation email links. No trailing slash.
# Example: http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit the real value.
# Required to send Supabase Auth invitation emails. Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
